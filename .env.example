# JobSync Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration
# =============================================================================
DB_ROOT_PASSWORD=ChangeMeRootPassword123
DATABASE_NAME=jobsync
DATABASE_USER=jobsync
DATABASE_PASSWORD=ChangeMeUserPassword123
DATABASE_PORT=3306

# =============================================================================
# AI Service Configuration (Ollama)
# =============================================================================
# For local development with Ollama on host machine:
OLLAMA_HOST=host.docker.internal:11434
# For production with Ollama on same server:
# OLLAMA_HOST=localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# OAuth Configuration
# Get these from Google Cloud Console and LinkedIn Developer Portal
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# =============================================================================
# Application URLs
# =============================================================================
# Public URL where the backend is accessible (used for OAuth callbacks)
BACKEND_URL=https://jobsync.ronning.systems
# CORS origins allowed to access the API (backend runs on port 8002 internally)
CORS_ORIGINS=https://jobsync.ronning.systems,https://app.jobsync.ronning.systems

# =============================================================================
# Stripe Configuration
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_product_price_id